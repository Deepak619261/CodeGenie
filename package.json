{
  "name": "nexuscode",
  "displayName": "NexusCode",
  "description": "Cost-aware coding agent: MiniMax workhorse, 3-tier router, per-task budget envelope.",
  "version": "0.1.0",
  "publisher": "nexuscode",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nexuscode.openChat",
        "title": "NexusCode: Open Chat"
      },
      {
        "command": "nexuscode.setBudget",
        "title": "NexusCode: Set Task Budget"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexuscode",
          "title": "NexusCode",
          "icon": "$(rocket)"
        }
      ]
    },
    "configuration": {
      "title": "NeoCode",
      "properties": {
        "nexuscode.backendUrl": {
          "type": "string",
          "default": "ws://127.0.0.1:8765/ws",
          "description": "WebSocket URL of the NexusCode backend server"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deepak619261/CodeGenie.git"
  },
  "dependencies": {
    "ws": "^8.16.0"
  }
}